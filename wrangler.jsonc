{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "link-launcher",
  "account_id": "4dddb56c05af56a431914f2cb7f48eb4",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "vars": { "MIGRATION_PENDING": "false" },
  "assets": {
    "directory": "./web-dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "none"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "link-launcher-vault",
    "database_id": "2ea49342-0c59-4ce2-abc4-a671e5db0b75",
    "migrations_dir": "cloudflare/migrations"
  }],
  "ratelimits": [
    { "name": "AUTH_LIMIT", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "LOGIN_LIMIT", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
    { "name": "REGISTER_LIMIT", "namespace_id": "1003", "simple": { "limit": 5, "period": 60 } }
  ]
}
